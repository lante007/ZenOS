# Auxeira ADEI Ingestion Engine — Environment Variables
# Copy this file to .env and fill in your values

# Google Drive API (service account JSON key file path)
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
ZENEX_DRIVE_FOLDER_ID=11kkaxcsqeDOsFAkBEEGk4dQ_n5imSi-J

# Anthropic API (primary classification — Claude Sonnet)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AWS (Bedrock resolution agent — Claude Haiku, Tier 2 resolution)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=af-south-1

# PostgreSQL (RDS — POPIA compliant, af-south-1)
DATABASE_URL=postgresql://username:password@your-rds-host:5432/evidenceos

# S3 (document storage)
AWS_S3_BUCKET=auxeira-evidenceos-af-south-1

# Processing limits
MAX_FILES_PER_BATCH=200
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_CLAUDE_CALLS=3
BATCH_TIMEOUT_MINUTES=20
