# Auxeira ADEI Ingestion Engine — Environment Variables
# Copy this file to .env and fill in your values

# Legacy Google Drive API (optional; S3 is the primary storage path)
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
ZENEX_DRIVE_FOLDER_ID=11kkaxcsqeDOsFAkBEEGk4dQ_n5imSi-J

# Anthropic API (primary classification — Claude Sonnet)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AWS (S3 storage, SQS, RDS, Cognito, Bedrock Tier 2 resolution)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# PostgreSQL (RDS PostgreSQL 15, us-east-1)
DATABASE_URL=postgresql://username:password@your-rds-host:5432/evidenceos

# Multi-tenant defaults
EVIDENCEOS_TENANT=zenex
AWS_S3_BUCKET=auxeira-evidenceos-zenex
AUTH_DISABLED=true
FOUNDER_EMAIL=emmanuel@auxeira.com

# Processing limits
MAX_FILES_PER_BATCH=200
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_CLAUDE_CALLS=3
BATCH_TIMEOUT_MINUTES=20
